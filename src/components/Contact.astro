---
import { contact } from "../config";
import { useTranslations, type Lang } from "../i18n/ui";
const { lang = "nl" } = Astro.props as { lang?: Lang };
const c = useTranslations(lang).contact;
const hasEmail = contact.email.trim().length > 0;
const hasPhone = contact.phone.trim().length > 0;
const socials = Object.entries(contact.social).filter(([, v]) => v.trim().length > 0);
---

<section class="contact section" id="contact">
  <div class="container contact__inner">
    <div class="contact__head">
      <p class="eyebrow reveal">{c.eyebrow}</p>
      <h2 class="section-title reveal" style="--reveal-delay:60ms">
        {c.title}
      </h2>
      <p class="lead reveal" style="--reveal-delay:120ms">
        {c.lead}
      </p>
    </div>

    <div class="contact__panel reveal card">
      <ul class="contact__list">
        <li class="contact__row">
          <span class="contact__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2.5" stroke="currentColor" stroke-width="1.6"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </span>
          <div class="contact__detail">
            <span class="contact__label">{c.email}</span>
            {
              hasEmail ? (
                <a class="contact__value" href={`mailto:${contact.email}`}>{contact.email}</a>
              ) : (
                <span class="contact__value contact__value--pending">{c.comingSoon}</span>
              )
            }
          </div>
        </li>

        <li class="contact__row">
          <span class="contact__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 5 5L19 13l2 5v3a1 1 0 0 1-1 1A16 16 0 0 1 4 6a1 1 0 0 1 1-2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          </span>
          <div class="contact__detail">
            <span class="contact__label">{c.phone}</span>
            {
              hasPhone ? (
                <a class="contact__value" href={`tel:${contact.phone.replace(/\s+/g, "")}`}>{contact.phone}</a>
              ) : (
                <span class="contact__value contact__value--pending">{c.comingSoon}</span>
              )
            }
          </div>
        </li>

        <li class="contact__row">
          <span class="contact__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M3 12h18M12 3c2.5 2.5 2.5 15 0 18M12 3C9.5 5.5 9.5 18.5 12 21" stroke="currentColor" stroke-width="1.4"/></svg>
          </span>
          <div class="contact__detail">
            <span class="contact__label">{c.social}</span>
            {
              socials.length ? (
                <span class="contact__socials">
                  {socials.map(([k, v]) => (
                    <a href={v} target="_blank" rel="noopener" class="contact__value">
                      {k[0].toUpperCase() + k.slice(1)}
                    </a>
                  ))}
                </span>
              ) : (
                <span class="contact__value contact__value--pending">{c.comingSoon}</span>
              )
            }
          </div>
        </li>
      </ul>

      <a
        class="btn btn--purple btn--lg contact__cta"
        href={hasEmail ? `mailto:${contact.email}` : "#donate"}
      >
        {hasEmail ? c.ctaEmail : c.ctaAlt}
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    background: linear-gradient(180deg, var(--bg-soft), #ffffff);
  }
  .contact__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .contact__panel {
    padding: clamp(1.6rem, 3.5vw, 2.5rem);
  }
  .contact__list {
    display: grid;
    gap: 0.4rem;
  }
  .contact__row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }
  .contact__row:last-child {
    border-bottom: none;
  }
  .contact__icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(138, 43, 136, 0.08);
    color: var(--purple);
  }
  .contact__icon svg {
    width: 22px;
    height: 22px;
  }
  .contact__detail {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .contact__label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .contact__value {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
    transition: color 0.2s var(--ease);
  }
  a.contact__value:hover {
    color: var(--purple);
  }
  .contact__value--pending {
    color: var(--muted);
    font-weight: 500;
  }
  .contact__socials {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .contact__cta {
    margin-top: 1.6rem;
    width: 100%;
  }

  @media (max-width: 820px) {
    .contact__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
