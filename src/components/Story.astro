---
import { useTranslations, type Lang } from "../i18n/ui";
const { lang = "nl" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
const journey = t.story.journey;
---

<section class="story section" id="story">
  <div class="container story__inner">
    <figure class="story__media reveal">
      <div class="story__photo-wrap">
        <img
          src="/images/founder-1400.jpg"
          srcset="/images/founder-900.jpg 900w, /images/founder-1400.jpg 1400w, /images/founder-2000.jpg 2000w"
          sizes="(max-width: 980px) 100vw, 46vw"
          width="1400"
          height="933"
          alt={t.story.photoAlt}
          loading="lazy"
        />
      </div>
      <figcaption class="story__signature">
        <span class="story__sig-name">Esther</span>
        <span class="story__sig-role">{t.story.sigRole}</span>
      </figcaption>
    </figure>

    <div class="story__body">
      <p class="eyebrow reveal">{t.story.eyebrow}</p>
      <h2 class="story__title reveal" style="--reveal-delay:60ms" set:html={t.story.titleHtml} />

      <div class="story__journey reveal" style="--reveal-delay:100ms" aria-hidden="true">
        {
          journey.map((step, i) => (
            <>
              <span class="story__step">{step}</span>
              {i < journey.length - 1 && <span class="story__arrow">→</span>}
            </>
          ))
        }
      </div>

      <div class="story__text reveal" style="--reveal-delay:160ms">
        <p>{t.story.p1}</p>
        <p>{t.story.p2}</p>

        <details class="story__more">
          <summary>
            <span>{t.story.readMore}</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <div class="story__more-body">
            <p>{t.story.more1}</p>
            <p>{t.story.more2}</p>
          </div>
        </details>
      </div>
    </div>
  </div>
</section>

<style>
  .story {
    background: var(--bg);
  }
  .story__inner {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .story__media {
    position: relative;
  }
  .story__photo-wrap {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .story__photo-wrap::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, transparent 55%, rgba(60, 22, 59, 0.28));
    pointer-events: none;
  }
  .story__photo-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3.4;
  }
  .story__signature {
    position: absolute;
    left: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(1rem, 3vw, 1.5rem);
    display: flex;
    flex-direction: column;
    color: #fff;
    z-index: 2;
  }
  .story__sig-name {
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    font-weight: 500;
    line-height: 1;
  }
  .story__sig-role {
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    opacity: 0.9;
    margin-top: 0.3rem;
  }

  .story__title {
    font-size: clamp(2.1rem, 5vw, 3.6rem);
    margin-top: 1rem;
    line-height: 1.02;
  }

  .story__journey {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.65rem;
    margin-top: 1.5rem;
  }
  .story__step {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--purple-700);
    background: rgba(138, 43, 136, 0.07);
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
  }
  .story__journey .story__step:nth-child(4n + 1) {
    color: var(--gold-700);
    background: rgba(242, 178, 51, 0.14);
  }
  .story__arrow {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .story__text {
    margin-top: 1.6rem;
    display: grid;
    gap: 1.1rem;
    color: var(--ink-2);
    font-size: 1.08rem;
    line-height: 1.7;
    max-width: 40rem;
  }

  .story__more {
    margin-top: 0.3rem;
    border-top: 1px solid var(--line);
    padding-top: 1.1rem;
  }
  .story__more summary {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    color: var(--purple);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .story__more summary::-webkit-details-marker {
    display: none;
  }
  .story__more summary svg {
    width: 18px;
    height: 18px;
    transition: transform 0.3s var(--ease);
  }
  .story__more[open] summary svg {
    transform: rotate(180deg);
  }
  .story__more-body {
    display: grid;
    gap: 1.1rem;
    margin-top: 1.1rem;
    animation: fade 0.4s var(--ease);
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (max-width: 980px) {
    .story__inner {
      grid-template-columns: 1fr;
    }
    .story__media {
      max-width: 560px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .story__more-body {
      animation: none;
    }
    .story__more summary svg {
      transition: none;
    }
  }
</style>
