---
// Only real documents should be linked. None supplied yet → clearly marked
// "in preparation". No ANBI status, registration numbers or figures are invented.
// Add a real URL to the matching hrefs entry to make a card live.
import { useTranslations, type Lang } from "../i18n/ui";
const { lang = "nl" } = Astro.props as { lang?: Lang };
const tr = useTranslations(lang).transparency;
const hrefs = ["", "", "", ""]; // Policy Plan, Annual Reports, Financial, Foundation
---

<section class="trans section" aria-labelledby="trans-title">
  <div class="container">
    <div class="head center">
      <p class="eyebrow center reveal">{tr.eyebrow}</p>
      <h2 class="section-title reveal" id="trans-title" style="--reveal-delay:60ms">
        {tr.title}
      </h2>
      <p class="lead reveal" style="--reveal-delay:120ms">
        {tr.lead}
      </p>
    </div>

    <div class="trans__grid">
      {
        tr.docs.map((d, i) => {
          const href = hrefs[i] ?? "";
          const available = href.trim().length > 0;
          const Tag = available ? "a" : "div";
          return (
            <Tag
              class={`trans__card reveal${available ? " is-available" : ""}`}
              style={`--reveal-delay:${(i % 4) * 60}ms`}
              {...(available ? { href, target: "_blank", rel: "noopener" } : {})}
            >
              <span class="trans__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M6 3h8l4 4v14a0 0 0 0 1 0 0H6a0 0 0 0 1 0 0V3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 3v4h4M8.5 13h7M8.5 16.5h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              </span>
              <h3 class="trans__card-title">{d.title}</h3>
              <p class="trans__card-desc">{d.desc}</p>
              <span class="trans__status">
                {available ? (
                  <>{tr.view}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></>
                ) : (
                  <>{tr.inPrep}</>
                )}
              </span>
            </Tag>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .trans {
    background: var(--bg-soft);
  }
  .trans__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(0.9rem, 2vw, 1.3rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .trans__card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.4rem, 2.5vw, 1.8rem);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    color: inherit;
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  .trans__card.is-available:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: rgba(138, 43, 136, 0.2);
  }
  .trans__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(138, 43, 136, 0.08);
    color: var(--purple);
    margin-bottom: 1rem;
  }
  .trans__icon svg {
    width: 22px;
    height: 22px;
  }
  .trans__card-title {
    font-size: 1.15rem;
  }
  .trans__card-desc {
    margin-top: 0.4rem;
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.5;
    flex: 1;
  }
  .trans__status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.1rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted);
  }
  .trans__card.is-available .trans__status {
    color: var(--purple);
  }
  .trans__status svg {
    width: 15px;
    height: 15px;
  }

  @media (max-width: 900px) {
    .trans__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 460px) {
    .trans__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
