---
const pillars = [
  {
    title: "Self-worth",
    body: "Every child learns to believe: “I am valuable.”",
    icon: "spark",
  },
  {
    title: "Identity",
    body: "Helping children discover who they truly are.",
    icon: "compass",
  },
  {
    title: "Family connection",
    body: "Strengthening the bond between children and parents.",
    icon: "link",
  },
  {
    title: "Hope",
    body: "A future worth looking forward to — with love.",
    icon: "sun",
  },
];
---

<section class="pillars section" id="pillars" aria-label="What we stand for">
  <div class="container">
    <p class="pillars__kicker reveal">
      Children<span>·</span>Identity<span>·</span>Hope<span>·</span>Love
    </p>

    <div class="pillars__grid">
      {
        pillars.map((p, i) => (
          <article class="pillar reveal" style={`--reveal-delay:${i * 70}ms`}>
            <span class="pillar__icon" aria-hidden="true">
              {p.icon === "spark" && (
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.7"/></svg>
              )}
              {p.icon === "compass" && (
                <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/><path d="m15.5 8.5-2 5-5 2 2-5 5-2Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
              )}
              {p.icon === "link" && (
                <svg viewBox="0 0 24 24" fill="none"><path d="M9 12a3 3 0 0 1 3-3h3a3 3 0 1 1 0 6h-1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M15 12a3 3 0 0 1-3 3H9a3 3 0 1 1 0-6h1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
              )}
              {p.icon === "sun" && (
                <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
              )}
            </span>
            <h3 class="pillar__title">{p.title}</h3>
            <p class="pillar__body">{p.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pillars {
    padding-block: clamp(3rem, 6vw, 5rem);
    background: var(--bg);
  }
  .pillars__kicker {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.9rem;
    font-size: clamp(1.1rem, 2.4vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .pillars__kicker span {
    color: var(--gold);
    font-weight: 700;
  }

  .pillars__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .pillar {
    padding: clamp(1.4rem, 2.5vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, #ffffff, var(--bg-soft));
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  .pillar:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: rgba(138, 43, 136, 0.2);
  }
  .pillar__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: rgba(138, 43, 136, 0.08);
    color: var(--purple);
    margin-bottom: 1rem;
  }
  .pillar__icon svg {
    width: 24px;
    height: 24px;
  }
  .pillar:nth-child(even) .pillar__icon {
    background: rgba(242, 178, 51, 0.16);
    color: var(--gold-700);
  }
  .pillar__title {
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }
  .pillar__body {
    font-size: 0.96rem;
    color: var(--muted);
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .pillars__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 460px) {
    .pillars__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
