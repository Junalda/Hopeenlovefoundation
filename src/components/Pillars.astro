---
const pillars = [
  {
    title: "Self-worth",
    body: "Every child learns to believe: “I am valuable.”",
    icon: "spark",
  },
  {
    title: "Identity",
    body: "Helping children discover who they truly are.",
    icon: "compass",
  },
  {
    title: "Family connection",
    body: "Strengthening the bond between children and parents.",
    icon: "link",
  },
  {
    title: "Hope",
    body: "A future worth looking forward to, with love.",
    icon: "sun",
  },
];
---

<section class="pillars section" id="pillars" aria-label="What we stand for">
  <div class="container">
    <p class="pillars__kicker reveal">
      Children<span>·</span>Identity<span>·</span>Hope<span>·</span>Love
    </p>

    <div class="pillars__grid">
      {
        pillars.map((p, i) => (
          <article class="pillar reveal" style={`--reveal-delay:${i * 70}ms`}>
            <h3 class="pillar__title">{p.title}</h3>
            <p class="pillar__body">{p.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pillars {
    padding-block: clamp(3rem, 6vw, 5rem);
    background: var(--bg);
  }
  .pillars__kicker {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.9rem;
    font-size: clamp(1.1rem, 2.4vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .pillars__kicker span {
    color: var(--gold);
    font-weight: 700;
  }

  .pillars__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .pillar {
    padding: clamp(1.4rem, 2.5vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, #ffffff, var(--bg-soft));
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  .pillar:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: rgba(138, 43, 136, 0.2);
  }
  .pillar__title {
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
    padding-top: 1rem;
    position: relative;
  }
  .pillar__title::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 34px;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--purple), var(--gold));
  }
  .pillar:nth-child(even) .pillar__title::before {
    background: linear-gradient(90deg, var(--gold), var(--purple));
  }
  .pillar__body {
    font-size: 0.96rem;
    color: var(--muted);
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .pillars__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 460px) {
    .pillars__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
