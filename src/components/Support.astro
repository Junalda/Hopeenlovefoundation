---
const items = [
  { title: "Children & activities", body: "A full day of care, attention and joy for every child.", icon: "child" },
  { title: "Workshops", body: "Materials and space for identity and confidence building.", icon: "book" },
  { title: "Sports & creativity", body: "Equipment for games, art, music and movement.", icon: "ball" },
  { title: "Meals & care", body: "Warm meals and food packages for families in need.", icon: "meal" },
  { title: "Gifts", body: "Backpacks, small gifts and encouragement to take home.", icon: "gift" },
  { title: "Future missions", body: "Reaching more islands, more families, year after year.", icon: "globe" },
];
---

<section class="support section" aria-labelledby="support-title">
  <div class="container">
    <div class="head center">
      <p class="eyebrow center reveal">Why donate</p>
      <h2 class="section-title reveal" id="support-title" style="--reveal-delay:60ms">
        Where does your support go?
      </h2>
      <p class="lead reveal" style="--reveal-delay:120ms">
        Every gift goes directly into creating meaningful experiences for children and
        practical support for their families.
      </p>
    </div>

    <div class="support__grid">
      {
        items.map((it, i) => (
          <article class="support__item reveal" style={`--reveal-delay:${(i % 3) * 70}ms`}>
            <h3 class="support__item-title">{it.title}</h3>
            <p class="support__item-body">{it.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .support {
    background: linear-gradient(180deg, #ffffff, var(--bg-soft));
  }
  .support__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.9rem, 2vw, 1.4rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .support__item {
    padding: clamp(1.4rem, 2.5vw, 1.8rem);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    border-left: 3px solid rgba(138, 43, 136, 0.35);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  .support__item:nth-child(even) {
    border-left-color: rgba(242, 178, 51, 0.5);
  }
  .support__item:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: rgba(138, 43, 136, 0.16);
    border-left-color: var(--purple);
  }
  .support__item:nth-child(even):hover {
    border-left-color: var(--gold);
  }
  .support__item-title {
    font-size: 1.15rem;
    margin-bottom: 0.3rem;
  }
  .support__item-body {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.55;
  }

  @media (max-width: 860px) {
    .support__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .support__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
