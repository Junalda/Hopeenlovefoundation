---
import { useTranslations, type Lang } from "../i18n/ui";
import ReadMore from "./ReadMore.astro";
const { lang = "nl" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
---

<section class="mission section" id="mission">
  <div class="container">
    <div class="mission__top">
      <div class="head">
        <p class="eyebrow reveal">{t.mission.eyebrow}</p>
        <h2 class="section-title reveal" style="--reveal-delay:60ms">
          {t.mission.title}
        </h2>
      </div>
      <p class="mission__intro lead reveal" style="--reveal-delay:120ms">
        {t.mission.intro}
      </p>
    </div>

    <blockquote class="mission__quote reveal">
      <span class="mission__quote-mark" aria-hidden="true">“</span>
      {t.mission.quote}
    </blockquote>

    <ReadMore more={t.common.showMore} less={t.common.showLess} collapsed={22} center>
      <div class="mission__grid">
        {
          t.mission.activities.map((a, i) => (
            <article class="act reveal" style={`--reveal-delay:${(i % 3) * 70}ms`}>
              <span class="act__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="act__title">{a.title}</h3>
              <p class="act__body">{a.body}</p>
            </article>
          ))
        }
      </div>
    </ReadMore>
  </div>
</section>

<style>
  .mission {
    background: linear-gradient(180deg, #ffffff, var(--bg-soft));
  }
  .mission__top {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: end;
  }
  .mission__intro {
    padding-bottom: 0.35rem;
  }

  .mission__quote {
    margin: clamp(2.2rem, 4vw, 3.2rem) 0;
    position: relative;
    padding: clamp(1.8rem, 4vw, 3rem) clamp(1.5rem, 5vw, 4rem);
    border-radius: var(--radius-xl);
    background: linear-gradient(120deg, var(--purple) 0%, var(--purple-700) 100%);
    color: #fff;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3.6vw, 2.6rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-align: center;
    overflow: hidden;
  }
  .mission__quote::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 120% at 85% 0%, rgba(242, 178, 51, 0.28), transparent 60%);
    pointer-events: none;
  }
  .mission__quote-mark {
    display: block;
    font-family: var(--font-serif);
    font-size: 3.5em;
    line-height: 0.4;
    height: 0.5em;
    color: var(--gold);
    opacity: 0.9;
  }

  .mission__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.9rem, 2vw, 1.4rem);
  }
  .act {
    padding: clamp(1.5rem, 2.5vw, 2rem);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  .act:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: rgba(138, 43, 136, 0.18);
  }
  .act__num {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--gold-700);
    margin-bottom: 0.9rem;
  }
  .act:nth-child(even) .act__num {
    color: var(--purple);
  }
  .act__title {
    font-size: 1.28rem;
    margin-bottom: 0.45rem;
  }
  .act__body {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  @media (max-width: 860px) {
    .mission__top {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .mission__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .mission__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
