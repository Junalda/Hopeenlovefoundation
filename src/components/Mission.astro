---
const activities = [
  { title: "Workshops", body: "Identity, self-confidence and daring to dream.", icon: "book" },
  { title: "Sports & games", body: "Play, teamwork and the joy of moving together.", icon: "ball" },
  { title: "Creativity", body: "Art, music and craft that let children express who they are.", icon: "brush" },
  { title: "Self-image", body: "Building a healthy, hopeful sense of self.", icon: "mirror" },
  { title: "Parent & child", body: "Strengthening and restoring the family bond.", icon: "family" },
  { title: "Education", body: "Encouraging learning, curiosity and growth.", icon: "grad" },
];
---

<section class="mission section" id="mission">
  <div class="container">
    <div class="mission__top">
      <div class="head">
        <p class="eyebrow reveal">Our Mission</p>
        <h2 class="section-title reveal" style="--reveal-delay:60ms">
          Every child deserves to know they are seen, valued and loved.
        </h2>
      </div>
      <p class="mission__intro lead reveal" style="--reveal-delay:120ms">
        We focus on children growing up in poverty, broken families and difficult
        circumstances, creating experiences where each child can feel, deep down:
      </p>
    </div>

    <blockquote class="mission__quote reveal">
      <span class="mission__quote-mark" aria-hidden="true">“</span>
      I am allowed to be here. I am valuable. I am loved.
    </blockquote>

    <div class="mission__grid">
      {
        activities.map((a, i) => (
          <article class="act reveal" style={`--reveal-delay:${(i % 3) * 70}ms`}>
            <span class="act__icon" aria-hidden="true">
              {a.icon === "book" && <svg viewBox="0 0 24 24" fill="none"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v15H5.5A1.5 1.5 0 0 0 4 20.5V5.5ZM20 5.5A1.5 1.5 0 0 0 18.5 4H13v15h5.5a1.5 1.5 0 0 1 1.5 1.5V5.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>}
              {a.icon === "ball" && <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M12 3a9 9 0 0 0 0 18M3 12h18M5.5 5.5c3 2 10 2 13 0M5.5 18.5c3-2 10-2 13 0" stroke="currentColor" stroke-width="1.4"/></svg>}
              {a.icon === "brush" && <svg viewBox="0 0 24 24" fill="none"><path d="M15 5l4 4-8.5 8.5a3 3 0 0 1-4.24 0 3 3 0 0 1 0-4.24L15 5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 6l4 4" stroke="currentColor" stroke-width="1.6"/></svg>}
              {a.icon === "mirror" && <svg viewBox="0 0 24 24" fill="none"><rect x="5" y="3" width="14" height="14" rx="7" stroke="currentColor" stroke-width="1.6"/><path d="M12 17v4M9 21h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>}
              {a.icon === "family" && <svg viewBox="0 0 24 24" fill="none"><circle cx="8" cy="8" r="2.6" stroke="currentColor" stroke-width="1.5"/><circle cx="16" cy="8" r="2.6" stroke="currentColor" stroke-width="1.5"/><path d="M4 19c0-2.8 1.8-4.5 4-4.5s4 1.7 4 4.5M12 19c0-2.8 1.8-4.5 4-4.5s4 1.7 4 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>}
              {a.icon === "grad" && <svg viewBox="0 0 24 24" fill="none"><path d="M12 4 2 9l10 5 10-5-10-5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M6 11v4c0 1.5 2.7 3 6 3s6-1.5 6-3v-4" stroke="currentColor" stroke-width="1.6"/></svg>}
            </span>
            <h3 class="act__title">{a.title}</h3>
            <p class="act__body">{a.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .mission {
    background: linear-gradient(180deg, #ffffff, var(--bg-soft));
  }
  .mission__top {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: end;
  }
  .mission__intro {
    padding-bottom: 0.35rem;
  }

  .mission__quote {
    margin: clamp(2.2rem, 4vw, 3.2rem) 0;
    position: relative;
    padding: clamp(1.8rem, 4vw, 3rem) clamp(1.5rem, 5vw, 4rem);
    border-radius: var(--radius-xl);
    background: linear-gradient(120deg, var(--purple) 0%, var(--purple-700) 100%);
    color: #fff;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3.6vw, 2.6rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-align: center;
    overflow: hidden;
  }
  .mission__quote::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 120% at 85% 0%, rgba(242, 178, 51, 0.28), transparent 60%);
    pointer-events: none;
  }
  .mission__quote-mark {
    display: block;
    font-family: var(--font-serif);
    font-size: 3.5em;
    line-height: 0.4;
    height: 0.5em;
    color: var(--gold);
    opacity: 0.9;
  }

  .mission__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.9rem, 2vw, 1.4rem);
  }
  .act {
    padding: clamp(1.5rem, 2.5vw, 2rem);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }
  .act:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: rgba(138, 43, 136, 0.18);
  }
  .act__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 15px;
    background: linear-gradient(135deg, rgba(138, 43, 136, 0.1), rgba(242, 178, 51, 0.14));
    color: var(--purple);
    margin-bottom: 1.1rem;
  }
  .act__icon svg {
    width: 26px;
    height: 26px;
  }
  .act__title {
    font-size: 1.28rem;
    margin-bottom: 0.45rem;
  }
  .act__body {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  @media (max-width: 860px) {
    .mission__top {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .mission__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .mission__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
