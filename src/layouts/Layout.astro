---
import "../styles/global.css";
import { site } from "../config";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Hope & Love Foundation | Creating Hope for Children",
  description = site.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL("/images/og-image.jpg", site.url).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: site.legalName,
  alternateName: site.name,
  slogan: site.slogan,
  url: site.url,
  description: site.description,
  logo: new URL("/images/logo-900.png", site.url).href,
  areaServed: ["Curaçao", "Aruba", "Bonaire", "Suriname", "Netherlands"],
  founder: { "@type": "Person", name: "Esther Macnack" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#8a2b88" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Hope & Love Foundation" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />

    <script>
      // ---------- Scroll reveal ----------
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
      if (prefersReduced || !("IntersectionObserver" in window)) {
        revealEls.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.1 }
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // ---------- Copy-to-clipboard (IBAN etc.) ----------
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const value = btn.getAttribute("data-copy") || "";
          try {
            await navigator.clipboard.writeText(value);
          } catch {
            const ta = document.createElement("textarea");
            ta.value = value;
            document.body.appendChild(ta);
            ta.select();
            try {
              document.execCommand("copy");
            } catch {}
            document.body.removeChild(ta);
          }
          const label = btn.querySelector("[data-copy-label]");
          const prev = label?.textContent;
          if (label) label.textContent = "Copied";
          btn.classList.add("is-copied");
          window.setTimeout(() => {
            if (label && prev) label.textContent = prev;
            btn.classList.remove("is-copied");
          }, 1800);
        });
      });
    </script>
  </body>
</html>
