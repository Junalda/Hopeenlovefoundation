---
import "../styles/global.css";
import { site, contact, founder, board } from "../config";
import { useTranslations, type Lang } from "../i18n/ui";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
}

const { lang = "nl", title, description } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;

// Single source of truth for absolute URLs: the `site` from astro.config.mjs.
const base = Astro.site ?? new URL(site.url);
const abs = (path: string) => new URL(path, base).href;

const canonical = abs(Astro.url.pathname);
const ogImage = abs("/images/og-image.jpg");
const nlUrl = abs("/");
const enUrl = abs("/en/");

// ---- Structured data (schema.org) ----
const orgId = abs("#organization");
const phone = contact.phone.replace(/[\s()]/g, "");
const members = board.map((m, i) => ({
  "@type": "OrganizationRole",
  roleName: t.leadership.roles[i],
  member: { "@type": "Person", name: m.name },
}));

const organization = {
  "@type": "NGO",
  "@id": orgId,
  name: site.legalName,
  alternateName: site.name,
  slogan: site.slogan,
  url: nlUrl,
  description: pageDescription,
  inLanguage: lang,
  logo: abs("/images/logo-900.png"),
  image: ogImage,
  email: contact.email,
  telephone: phone,
  foundingDate: site.foundingDate,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Beneluxlaan 668",
    postalCode: "1363 DA",
    addressLocality: "Almere",
    addressCountry: "NL",
  },
  // Intended area of work (not a claim of executed projects in each place).
  areaServed: ["Caribbean", "Suriname", "South America", "Netherlands"],
  founder: { "@type": "Person", name: founder.name },
  member: members,
  sameAs: [contact.social.instagram, contact.social.facebook, contact.social.linkedin].filter(
    Boolean
  ),
  identifier: { "@type": "PropertyValue", propertyID: "KvK", value: site.kvk },
};

const event = {
  "@type": "Event",
  "@id": abs("#mission-curacao-2026"),
  name: lang === "nl" ? "Missie Curaçao 2026" : "Curaçao 2026 Mission",
  description:
    lang === "nl"
      ? "Een dag vol workshops, sport, spel, creativiteit en een warme maaltijd voor 60–75 kinderen op Curaçao."
      : "A day of workshops, sports, games, creativity and a warm meal for 60–75 children in Curaçao.",
  startDate: "2026-10",
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: "Curaçao",
    address: { "@type": "PostalAddress", addressCountry: "CW" },
  },
  organizer: { "@id": orgId },
  image: ogImage,
};

// FAQ structured data — mirrors the visible FAQ section (same questions/answers).
const faqPage = {
  "@type": "FAQPage",
  "@id": abs("#faq"),
  inLanguage: lang,
  mainEntity: t.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [organization, event, faqPage],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#8a2b88" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="nl" href={nlUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={nlUrl} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "nl" ? "nl_NL" : "en_US"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Hope & Love Foundation" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="skip-link">{lang === "nl" ? "Naar inhoud" : "Skip to content"}</a>
    <slot />

    <!-- Vercel Web Analytics + Speed Insights (official Astro components; static-friendly, no adapter) -->
    <Analytics />
    <SpeedInsights />

    <script>
      // ---------- Scroll reveal ----------
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
      if (prefersReduced || !("IntersectionObserver" in window)) {
        revealEls.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.1 }
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // ---------- Copy-to-clipboard (IBAN etc.) ----------
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const value = btn.getAttribute("data-copy") || "";
          try {
            await navigator.clipboard.writeText(value);
          } catch {
            const ta = document.createElement("textarea");
            ta.value = value;
            document.body.appendChild(ta);
            ta.select();
            try {
              document.execCommand("copy");
            } catch {}
            document.body.removeChild(ta);
          }
          const label = btn.querySelector("[data-copy-label]");
          const prev = label?.textContent;
          const copiedText = label?.getAttribute("data-copied") || "Copied";
          if (label) label.textContent = copiedText;
          btn.classList.add("is-copied");
          window.setTimeout(() => {
            if (label && prev) label.textContent = prev;
            btn.classList.remove("is-copied");
          }, 1800);
        });
      });
    </script>
  </body>
</html>
